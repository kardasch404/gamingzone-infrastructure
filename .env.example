# Database Configuration
POSTGRES_USER=gamingzone
POSTGRES_PASSWORD=gamingzone_secret
POSTGRES_DB=gamingzone
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Kafka Configuration
KAFKA_BROKER=kafka:9092
KAFKA_ZOOKEEPER=zookeeper:2181
KAFKA_CLIENT_ID=gamingzone

# ElasticSearch Configuration
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_secret

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Kibana
KIBANA_PORT=5601

# Service Ports
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
CATALOG_SERVICE_PORT=4002
INVENTORY_SERVICE_PORT=4003
CART_SERVICE_PORT=4004
ORDER_SERVICE_PORT=4005
PAYMENT_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
USER_PROFILE_SERVICE_PORT=4008
REVIEW_SERVICE_PORT=4009
SEARCH_SERVICE_PORT=4010
ANALYTICS_SERVICE_PORT=4011

# gRPC Ports
AUTH_GRPC_PORT=5001
CATALOG_GRPC_PORT=5002
INVENTORY_GRPC_PORT=5003
CART_GRPC_PORT=5004
ORDER_GRPC_PORT=5005
PAYMENT_GRPC_PORT=5006
NOTIFICATION_GRPC_PORT=5007
USER_PROFILE_GRPC_PORT=5008
REVIEW_GRPC_PORT=5009
SEARCH_GRPC_PORT=5010

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600

# Stripe Configuration
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_SES_FROM_EMAIL=noreply@gamingzone.com

# Node Environment
NODE_ENV=development
